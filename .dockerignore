# .dockerignore — esclude tutto dal build context tranne quello che serve.
# Senza questo file Railway/Docker carica TUTTO il repo (~26k file con
# frontend/node_modules) e va in errore "grpc: error while marshaling".

# === Frontend (gigantesco, non serve al backend) ===
frontend/
.expo/
node_modules/

# === Test reports & assets non necessari al runtime ===
test_reports/
tests/
backend_test*.py
test_result.md
design_guidelines.json
README.md

# === Emergent metadata & memory ===
.emergent/
memory/
scripts/

# === Git & dev ===
.git/
.gitignore
.gitconfig

# === Python cache & venvs ===
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# === IDE / OS ===
.vscode/
.idea/
.DS_Store
*.swp

# === Logs & temp ===
*.log
*.tmp
*.bak

# === Audio assets non runtime (verranno copiati esplicitamente se serve) ===
backend/voiceprint_data/
backend/sound_samples/

# === Env locale: ATTENZIONE → Emergent inietta i suoi .env al deploy,
# ma il file deve essere INCLUSO nel build context per essere sovrascritto.
# NON ignorare backend/.env o .env (deployment_agent BLOCKER 2026-06-21).

# === Build cache & artifacts (Fabio 2026-06-21 v15, post 7° deploy fail) ===
# Cartelle che NON devono mai entrare nel build context Emergent — facevano
# fallire l'upload dello snapshot per timeout (1.1GB → 813MB).
frontend/.metro-cache/
frontend/dist/
frontend/.expo/
scripts/output/

# === Archive: codice rimosso ma conservato per reference ===
**/_archive/
backend/_archive/
frontend/_archive/

# === Backend pycache (può sfuggire al pattern globale) ===
backend/__pycache__/
backend/**/__pycache__/

# === Patches: necessario per patch-package, MA non per il backend Docker ===
frontend/patches/
